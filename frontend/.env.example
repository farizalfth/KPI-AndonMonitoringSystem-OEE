# ---------------------------------------------------------------------------
# Frontend environment. Copy to `frontend/.env` (or `.env.local`).
# Only variables prefixed with VITE_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Base URL of the backend REST API.
# Leave empty to use the Vite dev proxy (`/api` -> http://localhost:4000),
# which avoids CORS problems during development.
VITE_API_BASE_URL=/api

# Target of the dev proxy (backend), only used by `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:4000

# Socket.IO endpoint used by the Andon board (Phase 5, member 3).
VITE_SOCKET_URL=

# Set to "true" to hide the Andon navigation/admin chrome on large screens.
VITE_ANDON_FULLSCREEN=false