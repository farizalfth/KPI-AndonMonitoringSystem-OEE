# ---------------------------------------------------------------------------
# Backend environment. Copy to `backend/.env` and adjust.
# The server refuses to start when a required variable in production is invalid.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# --- Database ---------------------------------------------------------------
# Local docker-compose (see /docker-compose.yml)
# DATABASE_URL=postgresql://andon:andon@localhost:5432/andon_oee
# NeonDB (paste the pooled connection string from the Neon console)
DATABASE_URL=
DB_POOL_MAX=10
DB_SSL=false

# --- Auth -------------------------------------------------------------------
# Development fallback only. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# --- HTTP -------------------------------------------------------------------
# Comma separated list of allowed origins.
CORS_ORIGIN=http://localhost:5173

# --- MQTT (Phase 4, member 3) ------------------------------------------------
MQTT_ENABLED=false
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_ROOT=production/machine

# --- WebSocket (Phase 5, member 3) -------------------------------------------
WEBSOCKET_ENABLED=false

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=debug