{
  "name": "@andon/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared types, enums and API contract constants for the Andon Monitoring System & OEE",
  "main": "dist/cjs/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'},null,2)+'\\n')\"",
    "typecheck": "tsc -p tsconfig.cjs.json --noEmit",
    "clean": "rm -rf dist"
  },
  "module": "dist/esm/index.js"
}
